# ---------- App ----------
APP_NAME=AI Engineering Studio
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ---------- Database ----------
# SQLite (dev). For Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./storage/studio.db

# ---------- Storage paths (relative to backend/) ----------
STORAGE_ROOT=./storage
DATASETS_DIR=./storage/datasets
MODELS_DIR=./storage/models
VECTORSTORES_DIR=./storage/vectorstores
ARTIFACTS_DIR=./storage/artifacts

# ---------- LLM / Embedding providers ----------
# Provider: ollama (default) | openai | anthropic
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3
EMBEDDING_DEFAULT_PROVIDER=ollama
EMBEDDING_DEFAULT_MODEL=nomic-embed-text

OLLAMA_BASE_URL=http://localhost:11434

# Optional — leave blank to disable
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# ---------- Vector store ----------
# faiss (default, local) | chroma | qdrant
VECTOR_STORE_DEFAULT=faiss
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Limits ----------
MAX_UPLOAD_MB=200
MAX_TRAINING_MINUTES=30

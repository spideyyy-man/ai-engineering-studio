from __future__ import annotations

import pickle
from pathlib import Path

import pandas as pd


MODEL_PATH = Path(__file__).with_name("model.pkl")


def load_model():
    with MODEL_PATH.open("rb") as f:
        return pickle.load(f)


# Feature columns the model was trained on — predict() input must contain these.
FEATURE_COLUMNS = {{ feature_columns | tojson }}


def predict_one(row: dict) -> "object":
    """Single-row prediction."""
    pipe = load_model()
    X = pd.DataFrame([row])[FEATURE_COLUMNS]
    return pipe.predict(X)[0]


def predict_batch(csv_path: str | Path) -> pd.DataFrame:
    """Batch prediction from a CSV with the same feature columns."""
    pipe = load_model()
    df = pd.read_csv(csv_path)
    missing = [c for c in FEATURE_COLUMNS if c not in df.columns]
    if missing:
        raise ValueError(f"CSV is missing required columns: {missing}")
    df = df.copy()
    df["prediction"] = pipe.predict(df[FEATURE_COLUMNS])
{% if task == "classification" %}    # Probabilities (if the underlying estimator supports them):
    try:
        proba = pipe.predict_proba(df[FEATURE_COLUMNS])
        for i, cls in enumerate(pipe.classes_):
            df[f"proba_{cls}"] = proba[:, i]
    except AttributeError:
        pass
{% endif %}    return df


if __name__ == "__main__":
    import sys

    if len(sys.argv) < 2:
        print("Usage: python sample_usage.py <input.csv>")
        sys.exit(1)
    out = predict_batch(sys.argv[1])
    out_path = "predictions.csv"
    out.to_csv(out_path, index=False)
    print(f"Wrote {len(out)} predictions to {out_path}")

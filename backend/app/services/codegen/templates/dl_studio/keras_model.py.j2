{% if needs_transformer %}


def transformer_encoder(num_heads: int, ff_dim: int, dropout: float):
    """A single Transformer encoder block (pre-norm), returned as a callable
    that maps a (timesteps, dim) tensor to the same shape."""
    def block(x):
        dim = x.shape[-1]
        attn = layers.MultiHeadAttention(num_heads=num_heads, key_dim=dim // num_heads)(x, x)
        attn = layers.Dropout(dropout)(attn)
        x = layers.LayerNormalization(epsilon=1e-6)(x + attn)
        ff = layers.Dense(ff_dim, activation="relu")(x)
        ff = layers.Dense(dim)(ff)
        ff = layers.Dropout(dropout)(ff)
        return layers.LayerNormalization(epsilon=1e-6)(x + ff)
    return block
